@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #RESTRICTED
define table z22ad070_vbak {
  key client : abap.clnt not null;
  key salesdocument : z22ad070_de_sorder not null;
  salesdocumenttype : abap.char(4);
  orderreason : abap.char(3);
  salesorganization : abap.char(4);
  distributionchannel : abap.char(2);
  division : abap.char(2);
  salesoffice : abap.char(4);
  salesgroup : abap.char(3);
  @Semantics.amount.currencyCode : 'z22ad070_vbak.currency'
